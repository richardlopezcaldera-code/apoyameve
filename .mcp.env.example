# Credenciales de los servidores MCP declarados en .mcp.json
#
# Copiá este archivo como `.mcp.env` (NO se commitea) y completá los valores.
# El hook .claude/hooks/session-start.sh carga automáticamente `.mcp.env` en la
# sesión, de modo que las referencias ${VAR} de .mcp.json se resuelven solas.
#
# Los servidores que usan OAuth (github, cloudflare) NO necesitan nada acá:
# abren el flujo de login la primera vez que se usan.

# ── postgres ──
# Cadena de conexión PostgreSQL. Ej: postgresql://usuario:clave@host:5432/basedatos
DATABASE_URI=

# ── supabase ──
# Personal Access Token de Supabase (Dashboard -> Account -> Access Tokens).
SUPABASE_ACCESS_TOKEN=
