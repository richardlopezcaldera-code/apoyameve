{
  "name": "mobiliariotech-avisos",
  "version": "0.1.0",
  "private": true,
  "description": "Generador de avisos publicitarios para MobiliarioTech (Cloudflare Workers + Jumpseller).",
  "scripts": {
    "build:css": "node --experimental-strip-types scripts/build-css.mjs",
    "dev": "npm run build:css && wrangler dev",
    "deploy": "npm run build:css && wrangler deploy",
    "build": "npm run build:css && wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "fflate": "^0.8.3",
    "hono": "^4.6.3",
    "workers-og": "^0.0.25"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "wrangler": "^3.80.0"
  }
}
